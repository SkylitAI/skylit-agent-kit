                      "exchange": "ARCA",
                      "format": "price",
                      "has_daily": true,
                      "has_intraday": true,
                      "has_weekly_and_monthly": true,
                      "intraday_multipliers": [
                        "1",
                        "60"
                      ],
                      "minmov": 1,
                      "name": "SPY",
                      "pricescale": 100,
                      "session": "0930-1600",
                      "supported_resolutions": [
                        "1",

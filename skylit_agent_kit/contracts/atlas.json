{
  "components": {
    "headers": {
      "CreditsRemaining": {
        "description": "Credit balance remaining after this request was debited.",
        "schema": {
          "example": 4999,
          "type": "integer"
        }
      }
    },
    "parameters": {
      "Symbol": {
        "description": "Ticker (e.g. `SPY`).",
        "in": "query",
        "name": "symbol",
        "required": true,
        "schema": {
          "example": "SPY",
          "type": "string"
        }
      }
    },
    "responses": {
      "AccountSuspended": {
        "content": {
          "application/json": {
            "examples": {
              "suspended": {
                "value": {
                  "error": {
                    "code": "account_suspended",
                    "message": "Account suspended."
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Unknown, revoked or expired API key (the gateway's `forbidden`), or the account is not API-eligible (`account_suspended`). Not retryable."
      },
      "InsufficientCredits": {
        "content": {
          "application/json": {
            "examples": {
              "outOfCredits": {
                "value": {
                  "error": {
                    "code": "insufficient_credits",
                    "message": "Out of credits."
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Credit balance is below the request cost.",
        "headers": {
          "X-Credits-Remaining": {
            "$ref": "#/components/headers/CreditsRemaining"
          }
        }
      },
      "RateLimited": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Per-minute rate limit exceeded.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        }
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Missing or invalid API key."
      },
      "Unavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "The credit ledger or datafeed is temporarily unavailable."
      }
    },
    "schemas": {
      "DatafeedConfig": {
        "properties": {
          "exchanges": {
            "items": {
              "properties": {
                "desc": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "intraday_multipliers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "max_fetch_trading_days": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Max trading days one `/v1/history` request may span, keyed by\nresolution. Resolutions sharing a bar tier share a value \u2014 `60`,\n`240` and `480` all read hourly bars and all cap at 720.\n",
            "example": {
              "1": 90,
              "240": 720,
              "60": 720,
              "D": 2600
            },
            "type": "object"
          },
          "supported_resolutions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "supports_group_request": {
            "type": "boolean"
          },
          "supports_marks": {
            "type": "boolean"
          },
          "supports_search": {
            "type": "boolean"
          },
          "supports_time": {
            "type": "boolean"
          },
          "supports_timescale_marks": {
            "type": "boolean"
          },
          "symbols_types": {
            "items": {
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "description": "Stable machine-readable code.",
            "example": "insufficient_credits",
            "type": "string"
          },
          "docs_url": {
            "description": "Link to this code's entry on https://www.skylit.ai/docs/api-reference/errors. Optional: read it when present, never require it.",
            "format": "uri",
            "type": "string"
          },
          "message": {
            "description": "Human-readable explanation; wording may change",
            "key off `code`.": null,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "HistoryError": {
        "description": "UDF-shaped error body for a rejected `/v1/history` request. `errmsg` is\nthe human-readable text a TradingView datafeed surfaces; `requested_days`\nand `max_days` are additive fields for programmatic callers, which are\nthe ones that have to react \u2014 compute your page size from `max_days`\nrather than hardcoding a cap that later drifts.\n",
        "properties": {
          "errmsg": {
            "type": "string"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBody",
            "description": "The same failure in the platform error envelope (`code`, `message`)."
          },
          "max_days": {
            "description": "Trading days one request may span at this resolution's tier.",
            "type": "integer"
          },
          "requested_days": {
            "description": "Trading days the requested window spans.",
            "type": "integer"
          },
          "s": {
            "enum": [
              "error"
            ],
            "type": "string"
          }
        },
        "required": [
          "s",
          "errmsg"
        ],
        "type": "object"
      },
      "HistoryNoData": {
        "properties": {
          "nextTime": {
            "description": "Unix seconds of the nearest earlier bar, when one exists.",
            "format": "int64",
            "type": "integer"
          },
          "s": {
            "enum": [
              "no_data"
            ],
            "type": "string"
          }
        },
        "required": [
          "s"
        ],
        "type": "object"
      },
      "HistoryOk": {
        "properties": {
          "bv": {
            "description": "Buy (aggressor) volume per bar, equities where available.",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "c": {
            "description": "Closes.",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "h": {
            "description": "Highs.",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "l": {
            "description": "Lows.",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "o": {
            "description": "Opens.",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "s": {
            "description": "Status flag.",
            "enum": [
              "ok"
            ],
            "type": "string"
          },
          "sv": {
            "description": "Sell (aggressor) volume per bar.",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "t": {
            "description": "Bar open times, Unix seconds (UTC), oldest-first.",
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "type": "array"
          },
          "uv": {
            "description": "Unclassified volume per bar.",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "v": {
            "description": "Volumes.",
            "items": {
              "type": "number"
            },
            "type": "array"
          }
        },
        "required": [
          "s",
          "t",
          "o",
          "h",
          "l",
          "c",
          "v"
        ],
        "type": "object"
      },
      "SearchResult": {
        "properties": {
          "description": {
            "type": "string"
          },
          "exchange": {
            "example": "ARCA",
            "type": "string"
          },
          "kind": {
            "description": "Present on indices (`index`); absent otherwise.",
            "type": "string"
          },
          "symbol": {
            "description": "Canonical internal identifier (echo back to /v1/symbols and /v1/history).",
            "type": "string"
          },
          "ticker": {
            "description": "Display ticker shown in the picker.",
            "type": "string"
          },
          "type": {
            "enum": [
              "stock",
              "etf",
              "index"
            ],
            "type": "string"
          }
        },
        "required": [
          "symbol",
          "ticker",
          "description",
          "exchange",
          "type"
        ],
        "type": "object"
      },
      "SymbolInfo": {
        "description": "TradingView `LibrarySymbolInfo`.",
        "properties": {
          "data_status": {
            "example": "streaming",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "exchange": {
            "example": "ARCA",
            "type": "string"
          },
          "format": {
            "example": "price",
            "type": "string"
          },
          "has_daily": {
            "type": "boolean"
          },
          "has_intraday": {
            "type": "boolean"
          },
          "has_seconds": {
            "type": "boolean"
          },
          "has_ticks": {
            "type": "boolean"
          },
          "has_weekly_and_monthly": {
            "type": "boolean"
          },
          "intraday_multipliers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "minmov": {
            "example": 1,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "pricescale": {
            "example": 100,
            "type": "integer"
          },
          "seconds_multipliers": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "session": {
            "example": "0930-1600",
            "type": "string"
          },
          "supported_resolutions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ticker": {
            "type": "string"
          },
          "timezone": {
            "example": "America/New_York",
            "type": "string"
          },
          "type": {
            "enum": [
              "stock",
              "etf",
              "index"
            ],
            "type": "string"
          },
          "volume_precision": {
            "example": 0,
            "type": "integer"
          }
        },
        "required": [
          "ticker",
          "name",
          "description",
          "type",
          "session",
          "timezone",
          "exchange",
          "minmov",
          "pricescale",
          "supported_resolutions"
        ],
        "type": "object"
      },
      "UdfError": {
        "description": "Symbol-resolution error (UDF-native shape).",
        "properties": {
          "error": {
            "type": "string"
          },
          "success": {
            "enum": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "error"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerApiKey": {
        "description": "Skylit API key in the `Authorization` header\n(`Authorization: Bearer <key>`). The same\nkey works across Atlas, Heatseeker, and Flowseeker.\n",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Atlas exposes Skylit's real-time and historical **OHLCV** (open / high / low\n/ close / volume) price bars as a versioned public HTTP API that implements\nthe TradingView **UDF** (Universal Data Feed) datafeed contract. Point a\nTradingView Charting Library datafeed at `https://atlas-api.skylit.ai/v1`, or\ncall the endpoints directly.\n\n**Authentication.** Send your Skylit API key as a bearer token:\n\n    Authorization: Bearer <key>\n\nA request without it gets `401`; an invalid key gets `403`.\nThe gateway also accepts the bare key in the same header\n(`Authorization: <key>`); `Bearer` is the documented form. The key is not\nread from `X-API-Key` or the query string: those requests get `401`. One Skylit key spans every product \u2014\nthe same key and credit balance work for Heatseeker and Flowseeker.\n\n**Credit metering.** Each chargeable request debits a fixed cost from your\nbalance:\n\n| Endpoint       | Cost |\n|----------------|-----:|\n| `/v1/history`  | 1    |\n| `/v1/search`   | 1    |\n| `/v1/symbols`  | 1    |\n| `/v1/config`   | 0    |\n| `/v1/time`     | 0    |\n| `/v1/openapi.json` | 0 |\n\nNew customers are seeded with 5,000 credits. Every chargeable response\ncarries `X-Credits-Remaining: <balance>`. Out of credits \u2192 `402`\n`insufficient_credits`; a suspended account \u2192 `403`\n`account_suspended`. `/v1/config` and `/v1/time` are free metadata calls.\n**Failed calls are free:** a request answered with any `4xx` or `5xx` is\nrefunded, and its `X-Credits-Remaining` already reflects the refund.\n\nNote that a charting client fetches `/v1/history` in **pages** (it walks the\n`to` cursor backward to fill the requested range), so a deep history pull\nnaturally costs one credit per page \u2014 the cost scales with the data you\nactually retrieve.\n\n**Request-window limit.** One `/v1/history` call may span at most a fixed\nnumber of **trading days**, set by the bar tier the resolution reads from \u2014\nnot by the resolution itself. `240` and `60` share the 1-hour tier and\ntherefore share its allowance.\n\n| Tier   | Resolutions                | Max trading days / request |\n|--------|----------------------------|---------------------------:|\n| 1-min  | `1` `2` `3` `5` `15` `30`  |                         90 |\n| 1-hour | `60` `240` `480`           |                        720 |\n| 1-day  | `D` `W`                    |                      2,600 |\n\nA window **wider than the cap is rejected with `400`**, carrying the two\nnumbers a client needs to react (`requested_days`, `max_days`). It is never\nsilently shortened \u2014 a short `{ \"s\": \"ok\" }` always means the data ends\nthere, never that your range was clipped. Page through anything wider in\nwindows of `max_days` or fewer.\n\nA rejected `400` is refunded, like every failed call (any `4xx` or `5xx`):\nits `X-Credits-Remaining` already shows the refund. The caps are fixed and\npublished above, so check your range before sending it rather than\ndiscovering the limit by retrying.\n\n**Rate limits.** A safety ceiling of 600 requests / minute per key is\nenforced by the Skylit gateway; over it the gateway answers `429`\n`rate_limited`. This is runaway protection, not a quota: credit metering\ndoes the per-customer accounting. Responses carry `X-RateLimit-Limit` (the\nceiling, 600), `X-RateLimit-Remaining` (requests left in the current\nwindow) and `X-RateLimit-Reset` (Unix time, in seconds, when the window\nresets). The gateway's `429` has no `Retry-After`: wait until\n`X-RateLimit-Reset`. `429`s from the API itself (concurrency and stream\nlimits) carry `Retry-After`.\n\n**The datafeed flow.** A UDF client calls `/v1/config` once for the feed's\ncapabilities, `/v1/symbols` to resolve a ticker (price scale, session,\nsupported resolutions), then `/v1/history` for the bars; `/v1/search` powers\nthe symbol picker and `/v1/time` the server clock. History follows the UDF\nconvention: a `200` with `{ \"s\": \"ok\", ... }` on success and `{ \"s\":\n\"no_data\" }` when the window has no bars (not a `404`); an over-wide range\nis a `400` with `{ \"s\": \"error\", \"errmsg\": ... }` plus `requested_days` and\n`max_days`. Auth and credit errors, which aren't part of UDF, use the\nenvelope `{ \"error\": { \"code\": \"...\", \"message\": \"...\" } }`.\n",
    "summary": "OHLCV price history as a TradingView-UDF datafeed.",
    "title": "Atlas Public API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/config": {
      "get": {
        "description": "The static UDF `DatafeedConfiguration` \u2014 supported resolutions,\nexchanges, symbol types, and feature flags. Free.\n\nAlso carries **`max_fetch_trading_days`**: the `/v1/history`\nrequest-window cap, keyed by every advertised resolution. Read it once\nat startup and size your history pages from it, rather than hardcoding a\nwindow that later drifts \u2014 or discovering the limit by being rejected,\nwhich costs a credit each time. This call is free precisely so the limit\nis knowable in advance.\n\nThe values are served from the same limits the server enforces, so they\ncannot disagree with it. A charting client can ignore the field: it is\nnot part of the UDF spec, and TradingView skips config keys it does not\nrecognise.\n\n\u26a0 Cached for an hour (`max-age=3600`), so treat a `400` naming a\n`max_days` SMALLER than your cached value as authoritative and re-read\nthis endpoint.\n",
        "operationId": "getConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "config": {
                    "value": {
                      "exchanges": [
                        {
                          "desc": "NASDAQ",
                          "name": "NASDAQ",
                          "value": "NASDAQ"
                        },
                        {
                          "desc": "NYSE",
                          "name": "NYSE",
                          "value": "NYSE"
                        },
                        {
                          "desc": "NYSE ARCA",
                          "name": "NYSE ARCA",
                          "value": "ARCA"
                        }
                      ],
                      "intraday_multipliers": [
                        "1",
                        "60"
                      ],
                      "max_fetch_trading_days": {
                        "1": 90,
                        "15": 90,
                        "2": 90,
                        "240": 720,
                        "3": 90,
                        "30": 90,
                        "480": 720,
                        "5": 90,
                        "60": 720,
                        "D": 2600,
                        "W": 2600
                      },
                      "supported_resolutions": [
                        "1",
                        "2",
                        "3",
                        "5",
                        "15",
                        "30",
                        "60",
                        "240",
                        "480",
                        "D",
                        "W"
                      ],
                      "supports_group_request": false,
                      "supports_marks": false,
                      "supports_search": true,
                      "supports_time": true,
                      "supports_timescale_marks": false,
                      "symbols_types": [
                        {
                          "name": "stock",
                          "value": "stock"
                        },
                        {
                          "name": "fund",
                          "value": "fund"
                        },
                        {
                          "name": "dr",
                          "value": "dr"
                        },
                        {
                          "name": "index",
                          "value": "index"
                        },
                        {
                          "name": "futures",
                          "value": "futures"
                        }
                      ]
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/DatafeedConfig"
                }
              }
            },
            "description": "Datafeed configuration."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/AccountSuspended"
          }
        },
        "summary": "Datafeed configuration",
        "tags": [
          "Meta"
        ],
        "x-credits": 0
      }
    },
    "/v1/history": {
      "get": {
        "description": "TradingView UDF history bars for one `symbol` at one `resolution`,\ncovering `[from, to)` (Unix seconds; `to` is exclusive). Returns column arrays (`t`, `o`,\n`h`, `l`, `c`, `v`) of equal length, oldest-first. When the window\nholds no bars the response is a `200` with `{ \"s\": \"no_data\" }` (plus\n`nextTime` pointing at the nearest earlier bar when one exists), per the\nUDF contract. Equity bars also carry sided-volume columns (`bv`/`sv`/`uv`\n= buy / sell / unclassified) where available.\n\n## Request-window limit\n\nOne call may span at most a fixed number of **trading days**, set by the\nbar tier the resolution reads from \u2014 not by the resolution itself. `240`\nand `60` share the 1-hour tier and therefore share its allowance.\n\n| Tier   | Resolutions                | Max trading days / request |\n|--------|----------------------------|---------------------------:|\n| 1-min  | `1` `2` `3` `5` `15` `30`  |                         90 |\n| 1-hour | `60` `240` `480`           |                        720 |\n| 1-day  | `D` `W`                    |                      2,600 |\n\nA window **wider than the cap is rejected with `400`**, carrying the two\nnumbers a client needs to react (`requested_days`, `max_days`). It is\nnever silently shortened \u2014 a short `{ \"s\": \"ok\" }` always means the data\nends there, never that your range was clipped. Page through anything\nwider in windows of `max_days` or fewer.\n\nA rejected `400` is refunded (failed calls are free). The caps are\nfixed and published here, so check your range before sending it rather\nthan discovering the limit by retrying. `/v1/config` is free if you\nwould rather read the feed's capabilities first.\n\nCache-Control tracks data freshness: today `max-age=2`, the prior\nsession `max-age=60`, older complete days `immutable`. A `400` is\n`no-store`.\n",
        "operationId": "getHistory",
        "parameters": [
          {
            "$ref": "#/components/parameters/Symbol"
          },
          {
            "description": "Bar size. Intraday minutes or `D`/`W`.",
            "in": "query",
            "name": "resolution",
            "required": true,
            "schema": {
              "enum": [
                "1",
                "2",
                "3",
                "5",
                "15",
                "30",
                "60",
                "240",
                "480",
                "D",
                "W"
              ],
              "example": "D",
              "type": "string"
            }
          },
          {
            "description": "Window start, Unix seconds (UTC).",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "example": 1748131200,
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Window end, Unix seconds (UTC).",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "example": 1748736000,
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "When set, return exactly this many bars ending at `to` (takes\nprecedence over `from`, per the UDF spec).\n",
            "in": "query",
            "name": "countback",
            "required": false,
            "schema": {
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Include extended-hours (pre / post-market) bars. Default is regular\ntrading hours only (09:30\u201316:00 ET).\n",
            "in": "query",
            "name": "extended",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "noData": {
                    "summary": "Empty window",
                    "value": {
                      "nextTime": 1746057600,
                      "s": "no_data"
                    }
                  },
                  "ok": {
                    "summary": "SPY daily (truncated)",
                    "value": {
                      "c": [
                        744.38,
                        733.68,
                        733.05
                      ],
                      "h": [
                        750.18,
                        745.61,
                        739.94
                      ],
                      "l": [
                        741.55,
                        732.88,
                        731.2
                      ],
                      "o": [
                        742.1,
                        744.02,
                        733.9
                      ],
                      "s": "ok",
                      "t": [
                        1748304000,
                        1748390400,
                        1748476800
                      ],
                      "v": [
                        61230400,
                        74910200,
                        58120900
                      ]
                    }
                  }
                },
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/HistoryOk"
                    },
                    {
                      "$ref": "#/components/schemas/HistoryNoData"
                    }
                  ]
                }
              }
            },
            "description": "Bars, or a `no_data` marker \u2014 both `200` per UDF.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "example": "public, max-age=2",
                  "type": "string"
                }
              },
              "X-Credits-Remaining": {
                "$ref": "#/components/headers/CreditsRemaining"
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "rangeTooWide": {
                    "summary": "171 trading days asked of the 90-day 1-minute tier",
                    "value": {
                      "errmsg": "requested range spans 171 trading days; resolution \"1\" allows at most 90 per request. Narrow the range, or page through it in windows of 90 trading days or fewer.",
                      "max_days": 90,
                      "requested_days": 171,
                      "s": "error"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/HistoryError"
                }
              }
            },
            "description": "Invalid request: the requested range is wider than the\nresolution's tier allows, or a parameter is missing or invalid\n(for example an unsupported `resolution`). Refunded, like every\nfailed call.\n",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "example": "no-store",
                  "type": "string"
                }
              },
              "X-Credits-Remaining": {
                "$ref": "#/components/headers/CreditsRemaining"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/InsufficientCredits"
          },
          "403": {
            "$ref": "#/components/responses/AccountSuspended"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryError"
                }
              }
            },
            "description": "Unknown symbol (`symbol_not_found`). Refunded."
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        },
        "summary": "OHLCV price bars for a symbol and resolution",
        "tags": [
          "History"
        ],
        "x-credits": 1
      }
    },
    "/v1/openapi.json": {

    "/v1/search": {
      "get": {
        "description": "Ranked symbol search for the datafeed's symbol picker (exact ticker >\nprefix > substring). Returns up to `limit` matches.\n",
        "operationId": "searchSymbols",
        "parameters": [
          {
            "description": "Search text (ticker or name fragment).",
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "example": "SP",
              "type": "string"
            }
          },
          {
            "description": "Max results. Stay within 1\u2013500; out-of-range values are not rejected today, and their behaviour is not guaranteed.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 25,
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "spy": {
                    "value": [
                      {
                        "description": "SPDR S&P 500 ETF Trust",
                        "exchange": "ARCA",
                        "symbol": "SPY",
                        "ticker": "SPY",
                        "type": "etf"
                      },
                      {
                        "description": "S&P 500 Index",
                        "exchange": "NASDAQ",
                        "symbol": "SPX",
                        "ticker": "SPX",
                        "type": "index"
                      }
                    ]
                  }
                },
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SearchResult"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Matching symbols.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "example": "public, max-age=300, stale-while-revalidate=60",
                  "type": "string"
                }
              },
              "X-Credits-Remaining": {
                "$ref": "#/components/headers/CreditsRemaining"
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Missing or invalid parameter (`invalid_parameter`). Refunded."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/InsufficientCredits"
          },
          "403": {
            "$ref": "#/components/responses/AccountSuspended"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          }
        },
        "summary": "Search symbols",
        "tags": [
          "Symbols"
        ],
        "x-credits": 1
      }
    },
    "/v1/symbols": {
      "get": {
